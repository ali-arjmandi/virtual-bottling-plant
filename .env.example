# Copy to .env and adjust. Every variable used by docker-compose.yml is listed here.

# --- L0 simulator ---
SIM_SEED=42                 # same seed, same run
SIM_SPEED=1                 # 1, 10 or 60 (× real time)
SIM_CORS_ORIGINS=           # comma-separated origins for the Instructor Station in dev

# --- L1 PLC ---
PLC_POLL_MS=50              # OpenPLC slave polling pause between cycles (ms)
PLC_SLAVE_TIMEOUT_MS=250    # reply timeout per remote I/O request (ms)

# --- L1/L2 edge bridge + UNS broker ---
BRIDGE_POLL_MS=250          # PLC status poll period (EDG-01)
SIM_EPOCH=2026-10-05T05:30:00Z  # wall time of sim t = 0; must match sim/config/line.yaml start_time
EMQX_NODE_COOKIE=change-me-cookie
EMQX_DASHBOARD_PASSWORD=change-me-dashboard
MQTT_EDGE_BRIDGE_PASSWORD=change-me-edge-bridge
MQTT_IGNITION_PASSWORD=change-me-ignition
MQTT_MES_API_PASSWORD=change-me-mes-api

# --- L2 Ignition SCADA/HMI ---
# Maker Edition licence from your Inductive Automation account (free, non-commercial).
# Secrets: set them in .env only, never commit them.
IGNITION_LICENSE_KEY=
IGNITION_ACTIVATION_TOKEN=
