              "dataType": "Boolean",
              "valueSource": "reference",
              "sourceTagPath": {
                "bindType": "parameter",
                "binding": "[MQTT Engine]Edge Nodes/DelftsSap/Line1/{Device}/Alarms/T301_LowLevel/FirstOut"
              }
            },
            {
              "name": "Priority",
              "tagType": "AtomicTag",
